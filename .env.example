# Which provider /capture uses by default: anthropic | openai | gemini | openrouter | ollama
WISP_PROVIDER=anthropic

# Which playbooks/<name>.json to use as the default system prompt
WISP_PLAYBOOK=general

# API keys -- only the one matching WISP_PROVIDER is required.
# In a packaged build, these are set for you by the Settings window
# instead (BYOK) -- .env is a dev-mode-only convenience.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenRouter: one key, many underlying models (openrouter.ai/keys).
# Model defaults to openai/gpt-4o-mini; override with WISP_OPENROUTER_MODEL,
# e.g. anthropic/claude-3.5-sonnet or google/gemini-flash-1.5.
OPENROUTER_API_KEY=
WISP_OPENROUTER_MODEL=

# Ollama: no key needed, just a local server (`ollama serve` + `ollama pull llava`)
WISP_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Backend URL the Electron app connects to (only change if you altered the port)
WISP_BACKEND_URL=http://127.0.0.1:8137

# Set to false if faster-whisper/sounddevice deps aren't installed on this
# machine (e.g. missing ffmpeg dev headers for PyAV) -- capture loop still
# works fully without it, just with an empty transcript_context.
WISP_WHISPER_ENABLED=true
